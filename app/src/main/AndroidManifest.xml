<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Compression runs as a foreground job so backgrounding the app cannot kill it.
         Android 15 calls that work mediaProcessing; older releases have no such type
         and use dataSync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_eq"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_eq"
        android:supportsRtl="true"
        android:theme="@style/Theme.MusicPlayer">

        <!-- No launcher intent-filter here: the five aliases below are the launcher
             entry points, and only the selected one is enabled. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name" />

        <activity-alias
            android:name=".LauncherEqualizer"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_eq"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_eq"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherVinyl"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_vinyl"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_vinyl"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherNote"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_note"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_note"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherWave"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_wave"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_wave"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPhones"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_phones"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_phones"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Remembers the chosen app language on Android 12 and lower.
             On Android 13+ the system stores it for us. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false"
            tools:ignore="MissingClass">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Background playback: the MediaSessionService owns the player, so audio
             survives the activity and appears on the lock screen. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Compression never talks to another app: no binder, no exported entry. -->
        <service
            android:name=".compression.CompressService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />
    </application>

</manifest>
